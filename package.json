{
  "name": "doctor-consultation-backend",
  "version": "1.0.0",
  "description": "Healthcare doctor consultation backend using Node.js, Express, and MySQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "all": "node scripts/start-all.js",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,green\" \"npm run dev\" \"npm run dev --prefix careflow-frontend\"",
    "start:all": "node scripts/start-all.js",
    "frontend": "npm run dev --prefix careflow-frontend",
    "build:frontend": "npm run build --prefix careflow-frontend",
    "db:init": "node database/init.js",
    "seed": "node database/seed.js",
    "test": "node test/run-all-tests.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:whitebox": "node --test test/whitebox/*.test.js",
    "test:blackbox": "node --test test/blackbox/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:api": "node --test test/api/*.test.js",
    "test:security": "node --test test/security/*.test.js",
    "test:production": "node --test test/production-readiness.test.js",
    "backup": "node scripts/backup.js",
    "stress-test": "node test/load/stress-test.js"
  },
  "keywords": [
    "healthcare",
    "telemedicine",
    "doctor-consultation",
    "nodejs",
    "express",
    "mysql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^13.1.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "joi": "^17.13.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "pdf-lib": "^1.17.1",
    "razorpay": "^2.9.5",
    "uuid": "^11.0.5",
    "winston": "^3.17.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.1"
  }
}
