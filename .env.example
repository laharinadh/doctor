# Server Configuration
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=doctor_consultation
DB_CONNECTION_LIMIT=10

# Redis Cache (Optional, in-memory fallback if unavailable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=false

# Authentication
# Use Firebase for real SMS OTP. Only use AUTH_MODE=test with NODE_ENV=test in automated tests.
AUTH_MODE=firebase
FIREBASE_SERVICE_ACCOUNT_PATH=config/firebase-service-account.json

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_sampleKeyId
RAZORPAY_KEY_SECRET=sampleRazorpaySecretKey
RAZORPAY_WEBHOOK_SECRET=sampleWebhookSecretKey

# PhonePe Payments (optional second gateway)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_REDIRECT_URL=http://localhost:5173/phonepe-return
PHONEPE_CALLBACK_URL=http://localhost:3000/api/v1/payments/phonepe/callback

# Platform Fee (INR)
DEFAULT_PLATFORM_FEE=99.00
APPOINTMENT_HOLD_MINUTES=10
INSTANT_ROOM_SECRET=replace-with-a-long-random-secret

# File Storage Configuration
LOCAL_STORAGE_DIR=storage
MAX_RECORD_SIZE_BYTES=102400
MAX_PHOTO_SIZE_BYTES=5242880
MAX_VIDEO_SIZE_BYTES=52428800
